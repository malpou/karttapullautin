{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karttapullautin.github.io/schema/geojson.schema.json",
  "title": "GeoJSON Output",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "crs": { "$ref": "#/$defs/Crs" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/Feature" }
    }
  },
  "$defs": {
    "Crs": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "name" },
        "properties": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" }
          }
        }
      }
    },
    "IsomCode": {
      "description": "An ISOM 2017-2 symbol code of the isom-maplibre symbol table, \"NNN.NNN\".",
      "type": "string",
      "pattern": "^[0-9]{3}\\.[0-9]{3}$"
    },
    "ContourProperties": {
      "type": "object",
      "required": ["isom_code"],
      "additionalProperties": false,
      "properties": {
        "isom_code": { "enum": ["101.000", "101.001", "102.000", "103.000"] },
        "symbol_name": { "type": "string" },
        "level_m": { "description": "The level the contour was traced at, in metres.", "type": "number" },
        "depression": { "type": "boolean" }
      }
    },
    "KnollProperties": {
      "type": "object",
      "required": ["isom_code"],
      "additionalProperties": false,
      "properties": {
        "isom_code": { "enum": ["109.000", "111.000"] },
        "symbol_name": { "type": "string" },
        "ugly": { "type": "boolean" }
      }
    },
    "CliffProperties": {
      "type": "object",
      "required": ["isom_code"],
      "additionalProperties": false,
      "properties": {
        "isom_code": { "enum": ["201.000", "202.000"] },
        "symbol_name": { "type": "string" }
      }
    },
    "VegetationProperties": {
      "type": "object",
      "required": ["isom_code"],
      "additionalProperties": false,
      "properties": {
        "isom_code": { "enum": ["403.000", "406.000", "407.000", "408.000", "410.000"] },
        "shade": { "type": "integer", "minimum": 1 }
      }
    },
    "OsmProperties": {
      "type": "object",
      "required": ["isom_code", "category"],
      "additionalProperties": false,
      "properties": {
        "isom_code": { "$ref": "#/$defs/IsomCode" },
        "category": { "type": "string" },
        "upper_level": { "type": "boolean" }
      }
    },
    "Feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "enum": ["Point", "LineString", "Polygon"] },
            "coordinates": { "type": "array" }
          },
          "$comment": "RFC 7946 sizes: a LineString has two or more positions, a Polygon ring four or more. Written as a not, since the type generator reads no if/then.",
          "not": {
            "anyOf": [
              {
                "properties": {
                  "type": { "const": "LineString" },
                  "coordinates": { "maxItems": 1 }
                }
              },
              {
                "properties": {
                  "type": { "const": "Polygon" },
                  "coordinates": { "contains": { "maxItems": 3 } }
                }
              }
            ]
          }
        },
        "properties": {
          "oneOf": [
            { "$ref": "#/$defs/ContourProperties" },
            { "$ref": "#/$defs/KnollProperties" },
            { "$ref": "#/$defs/CliffProperties" },
            { "$ref": "#/$defs/VegetationProperties" },
            { "$ref": "#/$defs/OsmProperties" }
          ]
        }
      }
    }
  }
}
