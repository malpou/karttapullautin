{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karttapullautin.github.io/schema/geojson.schema.json",
  "title": "GeoJSON Output",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "crs": { "$ref": "#/$defs/Crs" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/Feature" }
    }
  },
  "$defs": {
    "Crs": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "name" },
        "properties": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" }
          }
        }
      }
    },
    "ContourProperties": {
      "type": "object",
      "required": ["symbol"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "enum": ["101", "102", "103"] },
        "symbol_name": { "type": "string" },
        "elevation": { "type": "number" },
        "depression": { "type": "boolean" },
        "slope_line": { "type": "boolean" }
      }
    },
    "KnollProperties": {
      "type": "object",
      "required": ["symbol"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "enum": ["109", "111"] },
        "symbol_name": { "type": "string" },
        "ugly": { "type": "boolean" }
      }
    },
    "CliffProperties": {
      "type": "object",
      "required": ["symbol"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "enum": ["201", "202"] },
        "symbol_name": { "type": "string" }
      }
    },
    "VegetationProperties": {
      "type": "object",
      "required": ["symbol"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "enum": ["403", "406", "407", "408", "410"] },
        "shade": { "type": "number" }
      }
    },
    "OsmProperties": {
      "type": "object",
      "required": ["symbol", "category"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "type": "string" },
        "category": { "type": "string" },
        "upper_level": { "type": "boolean" }
      }
    },
    "Feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "enum": ["Point", "LineString", "Polygon"] },
            "coordinates": { "type": "array" }
          }
        },
        "properties": {
          "oneOf": [
            { "$ref": "#/$defs/ContourProperties" },
            { "$ref": "#/$defs/KnollProperties" },
            { "$ref": "#/$defs/CliffProperties" },
            { "$ref": "#/$defs/VegetationProperties" },
            { "$ref": "#/$defs/OsmProperties" }
          ]
        }
      }
    }
  }
}
